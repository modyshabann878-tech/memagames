{
  "rules": {
    ".read": false,
    ".write": false,
    "lobbies": {
      "$key": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)"
        }
      }
    },
    "rooms": {
      "$code": {
        "public": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              "name": { ".validate": "newData.isString() && newData.val().length <= 20" }
            }
          },
          "inputs": {
            "$uid": { ".write": "auth != null && auth.uid === $uid" }
          },
          "chat": {
            "$id": {
              ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($code).child('public').child('players').child(auth.uid).exists()",
              ".validate": "newData.hasChildren(['uid','text']) && newData.child('text').isString() && newData.child('text').val().length <= 200"
            }
          }
        },
        "private": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && root.child('rooms').child($code).child('public').child('host').val() === auth.uid"
          }
        }
      }
    }
  }
}
